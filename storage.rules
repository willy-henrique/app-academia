rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    match /avatars/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isImageUpload();
      allow delete: if isOwner(uid);
    }

    match /progress/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isImageUpload();
      allow delete: if isOwner(uid);
    }

    match /user-content/{uid}/{allPaths=**} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
