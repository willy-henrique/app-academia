{
  "name": "willtreino",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run local",
    "dev:watch": "next dev --turbopack",
    "local": "node scripts/clean-next.mjs && npm run build && npm run start",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.mts tests/integration",
    "test:emulator": "RESOLVE_PUBLIC_USER_ID_RATE_LIMIT=3 RESOLVE_PUBLIC_USER_ID_RATE_LIMIT_WINDOW_SECONDS=600 SEND_TRAINING_INVITE_RATE_LIMIT=3 SEND_TRAINING_INVITE_RATE_LIMIT_WINDOW_SECONDS=600 firebase emulators:exec --project willtreino-local --only auth,firestore,functions,storage \"npm run test:integration\"",
    "emulators:start": "firebase emulators:start --project willtreino-local --only auth,firestore,functions,storage",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-toast": "1.2.23",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "firebase-functions": "7.3.2",
    "firebase-tools": "15.28.2",
    "jsdom": "29.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
